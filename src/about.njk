---
title: About
layout: layouts/base.njk
eleventyNavigation:
  key: About
  order: 4
---

{# ---- Page header ---- #}
<div class="page-header">
  <div class="page-header__inner">
    <p class="page-header__eyebrow">About</p>
    <h1 class="page-header__title">Caitlin Bannan</h1>
  </div>
</div>

{# ---- Bio ---- #}
<section class="about-bio">
  <div class="about-bio__inner">
    <div class="about-bio__photo">
      {% image
        "src/assets/img/calling-photo.jpg",
        "Caitlin Bannan calling a contra dance",
        "(min-width: 640px) 220px, 100vw",
        "",
        "eager"
      %}
    </div>
    <div class="about-bio__content">
      <p class="about-bio__role">Contra dance caller · Seattle, WA</p>
      <p class="about-bio__text">I'm a contra dance caller based in Seattle, WA, focused on creating evenings that are welcoming to newcomers and satisfying for experienced dancers. With experience organizing dance nights and weekends, I understand what it takes to bring a community together. I've called for family and community dances and love introducing this tradition to new audiences.</p>
    </div>
  </div>
</section>

{# ---- Contact ---- #}
<section class="about-contact">
  <div class="about-contact__inner">
    <h2 class="about-contact__title">Contact me</h2>
    <form
      class="contact-form"
      name="contact"
      method="POST"
      data-netlify="true"
    >
      <div class="contact-form__group">
        <label class="contact-form__label" for="name">Your name</label>
        <input
          class="contact-form__input"
          type="text"
          name="name"
          id="name"
          autocomplete="name"
          placeholder="Jane Smith"
          required
        >
      </div>

      <div class="contact-form__group">
        <label class="contact-form__label" for="email">Email address</label>
        <input
          class="contact-form__input"
          type="email"
          name="email"
          id="email"
          autocomplete="email"
          placeholder="jane@example.com"
          required
        >
      </div>

      <div class="contact-form__group--full">
        <label class="contact-form__label" for="message">Message</label>
        <textarea
          class="contact-form__textarea"
          name="message"
          id="message"
          placeholder="Say hello, ask about availability, or just tell me about your dance..."
          required
        ></textarea>
      </div>

      <div class="contact-form__submit">
        <button class="contact-form__submit-btn" type="submit">
          Send message
        </button>
      </div>
    </form>
  </div>
</section>
