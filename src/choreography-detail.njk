---
pagination:
  data: choreography
  size: 1
  alias: dance
permalink: "/choreography/{{ dance.slug }}/"
layout: layouts/base.njk
---

<article class="dance-detail">
  <header class="dance-header">
    <nav class="breadcrumb">
      <a href="/choreography/">← Back to all choreography</a>
    </nav>
    
    <h2 class="dance-title">{{ dance.title }}</h2>
    
    <div class="dance-meta">
      <span class="dance-formation">{{ dance.formation }}</span>
      {% if dance.progression %}
        <span class="meta-divider">·</span>
        <span class="dance-progression">{{ dance.progression }}</span>
      {% endif %}
      {% if dance.author %}
        <span class="meta-divider">·</span>
        <span class="dance-author">by {{ dance.author }}</span>
      {% endif %}
    </div>
  </header>

  {% if dance.figures and dance.figures.length %}
    <section class="dance-figures">
      <h2>Figures</h2>
      {% for fig in dance.figures %}
        <div class="figure-section">
          <div class="section-name">{{ fig.section }}</div>
            <ul class="move-list" style="list-style: none; padding: 0; margin: 0;">
              {% for move in fig.moves %}
                <li class="move-item" style="list-style: none; padding-left: 0;">{{ move }}</li>
              {% endfor %}
            </ul>
        </div>
      {% endfor %}
    </section>
  {% endif %}

  {% if dance.notes and dance.notes.length %}
    <section class="dance-notes">
      <h4>Notes</h4>
      <ul class="notes-list">
        {% for note in dance.notes %}
          <li class="note-item">{{ note }}</li>
        {% endfor %}
      </ul>
    </section>
  {% endif %}

  {% if dance.videos and dance.videos.length %}
    <section class="dance-videos">
      <h4>Videos</h4>
      <ul class="video-list">
        {% for video in dance.videos %}
          <li class="video-item">
            <a href="{{ video.url }}" target="_blank" rel="noopener" class="video-link">
              <svg class="video-icon" width="20" height="20" viewBox="0 0 20 20" fill="currentColor">
                <path d="M10 0C4.477 0 0 4.477 0 10s4.477 10 10 10 10-4.477 10-10S15.523 0 10 0zM8 14V6l6 4-6 4z"/>
              </svg>
              {{ video.label }}
            </a>
          </li>
        {% endfor %}
      </ul>
    </section>
  {% endif %}
</article>
