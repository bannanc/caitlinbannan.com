{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Gigs Year File",
  "description": "Generated by tools/export_gigs.py in caitlins_contra_database. Edit the database, not these files.",
  "type": "object",
  "required": ["year", "gigs"],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "year": {
      "type": "integer"
    },
    "gigs": {
      "type": "array",
      "items": { "$ref": "#/definitions/Gig" }
    }
  },
  "definitions": {
    "Gig": {
      "type": "object",
      "required": ["date", "series"],
      "additionalProperties": false,
      "properties": {
        "date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "Date in YYYY-MM-DD format; first day of a multi-day event"
        },
        "end_date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "Last day of a multi-day event. Omitted for one-day gigs"
        },
        "series": {
          "type": "string",
          "description": "Name of dance series or event"
        },
        "series_url": {
          "type": "string",
          "format": "uri"
        },
        "location": {
          "type": "string",
          "description": "City and state or country for the dance."
        },
        "bands": {
          "type": "array",
          "description": "Every band at the gig, usually one. Omitted while the band is TBA",
          "items": { "$ref": "#/definitions/Band" }
        },
        "program": {
          "$ref": "#/definitions/Program",
          "description": "Single-session gigs"
        },
        "notes": {
          "type": "string",
          "description": "Public notes for a multi-session gig"
        },
        "sessions": {
          "type": "array",
          "description": "Multi-session gigs (camps, weekends): one per session called",
          "items": { "$ref": "#/definitions/Session" }
        }
      }
    },
    "Band": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "description": "Band name, e.g. Countercurrent"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "members": {
          "type": "string",
          "description": "People in band and their instruments, e.g. Brian Lindsay (fiddle, feet, vocals) and Alex Staurbaum (guitar, vocals)"
        }
      }
    },
    "Program": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "description": "Optional session name"
        },
        "break_after": {
          "type": "integer",
          "description": "Number of dances in the first half."
        },
        "notes": {
          "type": "string"
        },
        "dances": {
          "type": "array",
          "items": { "$ref": "#/definitions/Dance" }
        }
      }
    },
    "Session": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "description": "e.g. Saturday Evening"
        },
        "band": {
          "type": "string",
          "description": "Name of one of the gig's bands"
        },
        "break_after": {
          "type": "integer"
        },
        "dances": {
          "type": "array",
          "items": { "$ref": "#/definitions/Dance" }
        }
      }
    },
    "Dance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string"
        },
        "author": {
          "type": "string"
        },
        "slug": {
          "type": "string",
          "description": "URL slug for dances authored by Caitlin"
        },
        "video": {
          "type": "string",
          "format": "uri"
        },
        "medley": {
          "type": "array",
          "description": "List of dances called as a medley",
          "items": {
            "type": "object",
            "required": ["title", "author"],
            "additionalProperties": false,
            "properties": {
              "title": {
                "type": "string"
              },
              "author": {
                "type": "string"
              },
              "slug": {
                "type": "string",
                "description": "URL slug for dances authored by Caitlin"
              }
            }
          }
        }
      }
    }
  }
}
