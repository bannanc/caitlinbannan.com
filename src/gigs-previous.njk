---
title: Past Programs
layout: layouts/base.njk
permalink: /gigs/previous/
---
{% from "macros/program.njk" import programList, sessionHeading, bandList %}

{# ---- Page header ---- #}
<div class="page-header">
  <div class="page-header__inner">
    <p class="page-header__eyebrow">Program archive</p>
    <h1 class="page-header__title">Previous Gigs</h1>
    <p class="page-header__subtitle">A record of nights called.</p>
  </div>
</div>

{# ---- Archive ---- #}
<section class="section-neutral">
  <div class="archive__inner">

    {% if gigs.previous.length %}

      {# Group gigs by year #}
      {% set currentYear = "" %}

      {% for gig in gigs.previous %}
        {% set gigYear = gig.date | date("yyyy") %}

        {# Year heading when year changes #}
        {% if gigYear != currentYear %}
          {% if currentYear != "" %}
            </div> {# close previous year group #}
          {% endif %}
          <div class="archive__year-group">
          <p class="archive__year-label">{{ gigYear }}</p>
          {% set currentYear = gigYear %}
        {% endif %}

        {# Gig entry #}
        <article class="gig-entry">

          {# Header: date + org + location + band #}
          <div class="gig-entry__header">
            <p class="gig-entry__date">{{ gig.date | gigDates(gig.end_date) }}</p>
            <div>
              {% if gig.series_url %}
                <a
                  class="gig-entry__org"
                  href="{{ gig.series_url }}"
                  target="_blank"
                  rel="noopener"
                >{{ gig.series }} ↗</a>
              {% else %}
                <span class="gig-entry__org--no-link">{{ gig.series }}</span>
              {% endif %}
              <p class="gig-entry__location">{{ gig.location }}</p>
              {% if gig.bands and gig.bands.length %}
                {{ bandList(gig, "gig-entry") }}
              {% endif %}
            </div>
          </div>

          {# Program: one list for a single session, or a heading + list per session #}
          {% if gig.sessions %}
            {% for session in gig.sessions %}
              {{ sessionHeading(session.name, session.band) }}
              {% if session.dances and session.dances.length %}
                {{ programList(session.dances, session.break_after) }}
              {% endif %}
            {% endfor %}
            {% if gig.notes %}
              <p class="program__notes">{{ gig.notes }}</p>
            {% endif %}
          {% elif gig.program and gig.program.dances and gig.program.dances.length %}
            {{ sessionHeading(gig.program.name) }}
            {{ programList(gig.program.dances, gig.program.break_after, gig.program.notes) }}
          {% endif %}

        </article>

        {% if loop.last %}
          </div> {# close last year group #}
        {% endif %}

      {% endfor %}

    {% else %}
      <p>No past gigs yet.</p>
    {% endif %}

  </div>
</section>
