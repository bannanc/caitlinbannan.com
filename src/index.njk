---
title: Home
layout: layouts/base.njk
---
<div class="home-page">
  {# Hero section #}
  <section class="hero">
    <div class="hero__col">
      <h1 class="hero__title gradient-text">{{ home.title }}</h1>
      {% if home.body %}
        <div class="hero__body">{{ home.body | markdown | safe }}</div>
      {% endif %}
    </div>
    <div class="hero__col">
      {% image
        home.image,
        home.image_alt,
        "(min-width: 1024px) 50vw, 100vw",
        "hero__image shadow",
        "eager"
      %}
    </div>
  </section>

  <!-- DEBUG START -->
  <!-- gigs variable: {{ gigs }} -->

  <section class="upcoming-gigs">
    <h2>Upcoming Gigs</h2>
    <div class="gig-list">
      {% for gig in gigs.upcoming %}
        <article class="gig-card">
          <h3 class="gig-series">{{ gig.series }}</h3>
          <div class="gig-details">
            <time class="gig-date" datetime="{{ gig.date }}">
              {{ gig.date | date("EEEE, MMMM d, yyyy") }}
            </time>
            <span class="gig-location">{{ gig.location }}</span>
          </div>
        </article>
      {% endfor %}
    </div>
    <p class="more">
      <a href="/gigs/">See all gigs →</a>
    </p>
  </section>
</div>