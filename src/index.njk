---
title: Home
layout: layouts/base.njk
---

<div class="home-page">
  {# Hero section #}
  <section class="hero">
    <div class="hero__col">
      <h1 class="hero__title gradient-text">{{ home.title }}</h1>
      {% if home.body %}
        <div class="hero__body">{{ home.body | markdown | safe }}</div>
      {% endif %}
    </div>
    <div class="hero__col">
      {% image
        home.image,
        home.image_alt,
        "(min-width: 1024px) 50vw, 100vw",
        "hero__image shadow",
        "eager"
      %}
    </div>
  </section>

  {# Upcoming gigs section #}
  {% if gigs.upcoming and gigs.upcoming.length %}
    <section class="upcoming-gigs">
      <h2>Upcoming Gigs</h2>

      <ul class="gig-list">
        {% for gig in gigs.upcoming | slice(0, 3) %}
          <li>
            <strong>
              {% if gig.series_url %}
                <a href="{{ gig.series_url }}" target="_blank" rel="noopener">
                  {{ gig.series }}
                </a>
              {% else %}
                {{ gig.series }}
              {% endif %}
            </strong>
            <br>

            <time datetime="{{ gig.date }}">
              {{ gig.date | date("MMMM d, yyyy") }}
            </time> · {{ gig.location }}

            {% if gig.band %}
              ·
              {% if gig.band_url %}
                <a href="{{ gig.band_url }}" target="_blank" rel="noopener">
                  {{ gig.band }}
                </a>
              {% else %}
                {{ gig.band }}
              {% endif %}
            {% endif %}
          </li>
        {% endfor %}
      </ul>

      <p class="more">
        <a href="/gigs/">See all gigs →</a>
      </p>
    </section>
  {% endif %}
</div>
