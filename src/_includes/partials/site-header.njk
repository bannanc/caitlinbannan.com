<header class="site-header">
  <div class="site-header__container">

    <a class="site-header__logo" href="{{ '/' | url }}">
      Caitlin Bannan
    </a>

    <button
      class="site-header__mobile-nav"
      data-drawer-trigger=""
      aria-controls="drawer-name"
      aria-expanded="false"
    >
      <span>Menu</span>
      {{ global.menu_icon | svg | safe }}
    </button>

    <nav class="site-header__nav">
      {% set navPages = collections.all | eleventyNavigation %}
      <ul class="site-header__items">
        {%- for entry in navPages %}
          {% if entry.title != "Home" %}
            <li class="site-header__item">
              <a
                class="site-header__link"
                href="{{ entry.url | url }}"
                {% if entry.url == page.url %}aria-current{% endif %}
              >
                {{ entry.title }}
              </a>
            </li>
          {% endif %}
        {%- endfor %}

        <li class="site-header__item">
          <a
            class="site-header__link site-header__link--cta"
            href="{{ '/about/' | url }}"
            {% if page.url == '/about/' %}aria-current{% endif %}
          >
            Contact me
          </a>
        </li>
      </ul>
    </nav>

  </div>
</header>
