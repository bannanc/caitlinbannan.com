{# One program (a single-session gig, or one session of a camp): numbered dances, break marker, notes #}
{% macro programList(dances, break_after, notes) %}
  <div class="program">
    {% for dance in dances %}

      <div class="program__dance">
        <span class="program__num">{{ loop.index }}</span>
        <span class="program__content">

          {# Medley #}
          {% if dance.medley %}
            <span class="program__medley-label">Medley</span>
            <span class="program__medley-list">
              {% for piece in dance.medley %}
                <span class="program__medley-item">
                  {% if piece.slug %}
                    <a class="program__title--own" href="/choreography/#{{ piece.slug }}">{{ piece.title }}</a>
                  {% else %}
                    <span class="program__title">{{ piece.title }}</span>
                  {% endif %}
                  <span class="program__author">{{ piece.author }}</span>
                </span>
              {% endfor %}
            </span>

          {# Own dance — linked to choreography page #}
          {% elif dance.slug %}
            <a
              class="program__title--own"
              href="/choreography/#{{ dance.slug }}"
            >{{ dance.title }}</a>
            {% if dance.author %}
              <span class="program__author">{{ dance.author }}</span>
            {% endif %}

          {# Everyone else — plain text #}
          {% else %}
            <span class="program__title">{{ dance.title }}</span>
            {% if dance.author %}
              <span class="program__author">{{ dance.author }}</span>
            {% endif %}
          {% endif %}

          {% if dance.video %}
            <a
              class="program__video"
              href="{{ dance.video }}"
              target="_blank"
              rel="noopener"
            >Watch video ↗</a>
          {% endif %}

        </span>
      </div>

      {# Break marker #}
      {% if break_after and loop.index == break_after %}
        <div class="program__break">
          <span class="program__break-line"></span>
          <span class="program__break-label">Break</span>
          <span class="program__break-line"></span>
        </div>
      {% endif %}

    {% endfor %}

    {% if notes %}
      <p class="program__notes">{{ notes }}</p>
    {% endif %}
  </div>
{% endmacro %}

{# Heading above a session's program: "Saturday Evening · Fortified" #}
{% macro sessionHeading(name, band) %}
  {% if name or band %}
    <p class="program__session">
      {{ name }}{% if name and band %} · {% endif %}{% if band %}<span class="program__session-band">{{ band }}</span>{% endif %}
    </p>
  {% endif %}
{% endmacro %}

{# Session names for an upcoming gig card, or nothing if no session is named #}
{% macro sessionNames(gig, prefix) %}
  {% set names = [] %}
  {% if gig.sessions %}
    {% for s in gig.sessions %}{% if s.name %}{% set names = (names.push(s.name), names) %}{% endif %}{% endfor %}
  {% elif gig.program and gig.program.name %}
    {% set names = [gig.program.name] %}
  {% endif %}
  {% if names.length %}
    <ul class="{{ prefix }}__sessions">
      {% for n in names %}<li>{{ n }}</li>{% endfor %}
    </ul>
  {% endif %}
{% endmacro %}

{# A gig's bands: name (linked if it has a URL) and members, one block per band; "Band TBA" if none #}
{% macro bandList(gig, prefix) %}
  {% if gig.bands and gig.bands.length %}
    {% for band in gig.bands %}
      <div class="{{ prefix }}__band-item">
        <p class="{{ prefix }}__band">
          {% if band.url %}<a href="{{ band.url }}" target="_blank" rel="noopener">{{ band.name }} ↗</a>{% else %}{{ band.name }}{% endif %}
        </p>
        {% if band.members %}
          <p class="{{ prefix }}__band-members">{{ band.members }}</p>
        {% endif %}
      </div>
    {% endfor %}
  {% else %}
    <p class="{{ prefix }}__tba">Band TBA</p>
  {% endif %}
{% endmacro %}
