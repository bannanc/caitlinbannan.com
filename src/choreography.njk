---
title: Choreography
layout: layouts/base.njk
eleventyNavigation:
  key: Choreography
  order: 3
---

{# ---- Page header ---- #}
<div class="page-header">
  <div class="page-header__inner">
    <p class="page-header__eyebrow">Choreography</p>
    <h1 class="page-header__title">Original dances</h1>
    <p class="page-header__subtitle">Click a dance name to jump to its full notation.</p>
  </div>
</div>

{# ---- Index list ---- #}
<section class="choreo-index">
  <div class="choreo-index__inner">
    <p class="choreo-index__label">All dances</p>
    <ul class="choreo-index__list">
      {% for dance in choreography %}
        <li class="choreo-index__item">
          <div class="choreo-index__item-main">
            <a
              class="choreo-index__name"
              href="#{{ dance.slug }}"
            >{{ dance.title }}</a>
            {% if dance.formation %}
              <span class="choreo-index__meta">{{ dance.formation }}</span>
            {% endif %}
            {% if dance.progression %}
              <span class="choreo-index__divider">·</span>
              <span class="choreo-index__meta">{{ dance.progression }}</span>
            {% endif %}
            {% if not dance["co-author"] and dance.notes and dance.notes.length > 0 %}
              <span class="choreo-index__divider">—</span>
              <span class="choreo-index__desc">{{ dance.notes[0] | truncate(80) }}</span>
            {% endif %}
          </div>
          {% if dance["co-author"] %}
            <p class="choreo-index__coauthor">Choreographed with
              {% if dance["co-author-url"] %}
                <a href="{{ dance['co-author-url'] }}" target="_blank" rel="noopener">{{ dance["co-author"] }} ↗</a>
              {% else %}
                {{ dance["co-author"] }}
              {% endif %}
            </p>
          {% endif %}
        </li>
      {% endfor %}
    </ul>
  </div>
</section>

{# ---- Dance cards ---- #}
<section class="choreo-cards">
  <div class="choreo-cards__inner">
    {% for dance in choreography %}
      <article class="dance-card" id="{{ dance.slug }}">

        {# Card header #}
        <div class="dance-card__header">
          <h2 class="dance-card__title">{{ dance.title }}</h2>
          {% if dance["co-author"] %}
            <p class="dance-card__coauthor">Choreographed with
              {% if dance["co-author-url"] %}
                <a href="{{ dance['co-author-url'] }}" target="_blank" rel="noopener">{{ dance["co-author"] }} ↗</a>
              {% else %}
                {{ dance["co-author"] }}
              {% endif %}
            </p>
          {% endif %}
          <div class="dance-card__meta">
            {% if dance.formation %}
              <span>{{ dance.formation }}</span>
            {% endif %}
            {% if dance.progression %}
              <span class="dance-card__meta-dot"></span>
              <span>{{ dance.progression }}</span>
            {% endif %}
          </div>
        </div>

        {# Card body: figures + notes #}
        <div class="dance-card__body">

          {# Figures #}
          {% if dance.figures and dance.figures.length %}
            <div class="dance-figures">
              <p class="dance-figures__title">Figures</p>
              {% for fig in dance.figures %}
                <div class="dance-figures__section">
                  <span class="dance-figures__label">{{ fig.section }}</span>
                  <p class="dance-figures__moves">
                    {%- for move in fig.moves -%}
                      {{ move }}{% if not loop.last %}<br>{% endif %}
                    {%- endfor -%}
                  </p>
                </div>
              {% endfor %}
            </div>
          {% endif %}

          {# Notes + video #}
          {% if (dance.notes and dance.notes.length) or (dance.videos and dance.videos.length) %}
            <div class="dance-notes">
              {% if dance.notes and dance.notes.length %}
                <p class="dance-notes__title">Notes</p>
                {% for note in dance.notes %}
                  <p class="dance-notes__item">{{ note }}</p>
                {% endfor %}
              {% endif %}
              {% if dance.videos and dance.videos.length %}
                {% for video in dance.videos %}
                  <a
                    class="dance-notes__video"
                    href="{{ video.url }}"
                    target="_blank"
                    rel="noopener"
                  >Watch video ↗{% if dance.videos.length > 1 %} — {{ video.label }}{% endif %}</a>
                {% endfor %}
              {% endif %}
            </div>
          {% endif %}

        </div>
      </article>
    {% endfor %}
  </div>
</section>
