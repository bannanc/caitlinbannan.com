---
title: Gigs
layout: layouts/base.njk
eleventyNavigation:
  key: Gigs
  order: 2
---

{# ---- Page header ---- #}
<div class="page-header">
  <div class="page-header__inner">
    <p class="page-header__eyebrow">Schedule</p>
    <h1 class="page-header__title">Upcoming Gigs</h1>
    <p class="page-header__subtitle">Come dance! Use the links to find details about the event.</p>
  </div>
</div>

{# ---- Upcoming gig cards ---- #}
<section class="section-neutral">
  <div class="upcoming-gigs__inner">

    {% if gigs.upcoming.length %}
      <div class="upcoming-gig-cards">
        {% for gig in gigs.upcoming %}
          <article class="upcoming-gig-card">
            <p class="upcoming-gig-card__month">
              {{ gig.date | date("MMM yyyy") }}
            </p>
            <p class="upcoming-gig-card__date">
              {{ gig.date | date("EEE, MMM d") }}
            </p>
            <div>
              {% if gig.series_url %}
                <a
                  class="upcoming-gig-card__org"
                  href="{{ gig.series_url }}"
                  target="_blank"
                  rel="noopener"
                >{{ gig.series }} ↗</a>
              {% else %}
                <p class="upcoming-gig-card__org--no-link">{{ gig.series }}</p>
              {% endif %}
              <p class="upcoming-gig-card__location">{{ gig.location }}</p>
            </div>
            {% if gig.band %}
              <div>
                <p class="upcoming-gig-card__band">{{ gig.band }}</p>
                {% if gig.band_members %}
                  <p class="upcoming-gig-card__band-members">{{ gig.band_members }}</p>
                {% endif %}
              </div>
            {% else %}
              <p class="upcoming-gig-card__tba">Band TBA</p>
            {% endif %}
          </article>
        {% endfor %}
      </div>

    {% else %}
      <p class="upcoming-gigs__empty">No upcoming gigs at the moment — check back soon!</p>
    {% endif %}

    {# Link to archive #}
    {% if gigs.previous.length %}
      <div class="archive-link-row">
        <a class="archive-link-row__link" href="{{ '/gigs/previous/' | url }}">
          Browse past programs →
        </a>
        <span class="archive-link-row__count">
          {{ gigs.previous.length }} previous gig{% if gigs.previous.length != 1 %}s{% endif %}
        </span>
      </div>
    {% endif %}

  </div>
</section>
